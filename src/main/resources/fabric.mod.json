{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "Allows you to rotate your camera freely around your character!",
    "authors": [
        "chromatic"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/freelook-oneconfig",
        "sources": "https://codeberg.org/chromatic/Freelook"
    },
    "contributors": [
        "awruff",
        "Tellinq",
        "zircta"
    ],
    "license": "LGPL-3.0",
    "icon": "assets/freelook/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "org.codeberg.chromatic.freelook.Freelook"
        ],
        "modmenu": [
            "org.codeberg.chromatic.freelook.integration.modmenu.ModMenuImpl"
        ]
    },
    "mixins": [
        "freelook.mixins.json"
    ],
    "depends": {
        "minecraft": "${minecraft}",
        "fabricloader": ">=0.17",
        "yet_another_config_lib_v3": "${yacl3}"
    },
    "recommends": {
        "modmenu": "*"
    },
    "conflicts": {
        "ichor": "*",
        "feather": "*"
    }
}
